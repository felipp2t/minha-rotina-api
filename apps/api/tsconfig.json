{
  "extends": "@minha-rotina/tsconfig/node.json",
  "compilerOptions": {
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@domain/*": ["src/domain/*"],
      "@core/*": ["src/core/*"],
      "@infra/*": ["src/infra/*"],
      "@test/*": ["test/*"]
    },
    "strictNullChecks": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
